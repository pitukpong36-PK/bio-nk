rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* อีเมลครู — ต้องตรงกับ Cloud.TEACHERS ใน js/cloud.js */
    function isTeacher() {
      return request.auth != null && request.auth.token.email in [
        'pitukpong36@brw.ac.th',
        'pitukpong36@gmail.com'
      ];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      /* นักเรียนอ่าน/เขียนได้เฉพาะข้อมูลของตัวเอง · ครูอ่านได้ทุกคน */
      allow read:   if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid)
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid);
      allow delete: if false;        /* ลบข้อมูลทำผ่านคอนโซลเท่านั้น */
    }

    /* ปิดทุกอย่างที่ไม่ได้ระบุไว้ข้างบน */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
